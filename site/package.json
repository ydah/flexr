    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.56.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.36.0",
    "@ruby/4.0-wasm-wasi": "2.10.1",
    "@ruby/wasm-wasi": "2.10.1",
    "@viz-js/viz": "3.25.0",
    "astro": "^5.14.1"
  }
}
