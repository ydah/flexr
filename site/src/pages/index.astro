---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const repo = 'https://github.com/ydah/flexr';
const example = String.raw`require "flexr"

class Lexer < Flexr::Lexer
  emits :INTEGER, :PLUS

  rule(/ +/, skip: true)
  rule(/[0-9]+/) { emit :INTEGER, text.to_i }
  rule(/\+/) { emit :PLUS }
end

Lexer.new("12 + 3").tokens
# => [[:INTEGER, 12], [:PLUS, "+"], [:INTEGER, 3]]`;
---
<SiteLayout
  title="A lexer generator for Ruby"
  description="Define lexer rules in Ruby. Run the lexer directly or generate a Ruby scanner."
>
  <main class="landing">
    <header class="landing-intro">
      <h1>A lexer generator for Ruby</h1>
      <p>Write rules that turn text into tokens. Run your lexer directly or generate a Ruby scanner from the same rules.</p>
      <div class="landing-actions">
        <code>gem install flexr</code>
        <a href={`${base}playground/`}>Try the playground</a>
      </div>
    </header>

    <section class="landing-example" aria-labelledby="example-title">
      <h2 id="example-title">Example</h2>
      <pre><code>{example}</code></pre>
    </section>
  </main>

  <footer class="landing-footer">
    <nav aria-label="Footer navigation">
      <a href={`${base}reference/dsl/`}>Reference</a>
      <a href={`${base}examples/`}>Examples</a>
      <a href={repo}>GitHub</a>
    </nav>
    <a href={`${repo}/blob/main/LICENSE.txt`}>MIT License</a>
  </footer>
</SiteLayout>
