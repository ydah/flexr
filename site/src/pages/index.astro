---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const repo = 'https://github.com/ydah/flexr';
---
<SiteLayout
  title="Predictable lexers, written in Ruby"
  description="Write lexer specifications in Ruby, inspect longest-match decisions, and generate deterministic Ruby for deployment with flexr."
>
  <main class="landing">
    <section class="landing-hero" aria-labelledby="hero-title">
      <p class="hero-kicker">Ruby-native lexer generator</p>
      <h1 id="hero-title">Turn Ruby rules into predictable tokens.</h1>
      <p class="hero-summary">
        Write one readable specification, inspect why each match wins, and generate deterministic
        Ruby when it is time to ship.
      </p>
      <div class="hero-actions">
        <a class="landing-button primary" href={`${base}learn/getting-started/`}>Build your first lexer</a>
        <a class="landing-button secondary" href={`${base}playground/`}>Try the matching model</a>
      </div>

      <figure class="lexer-sample">
        <figcaption><span>lexer.flexr.rb</span><span>input: if == total</span></figcaption>
        <pre><code><span>class</span> Lexer &lt; Flexr::Lexer
  rule(/==/) &#123; emit <span>:EQ</span> &#125;
  rule(/=/)  &#123; emit :ASSIGN &#125;
  rule(/if/) &#123; emit :IF &#125;
  rule(/[a-z_]+/) &#123; emit :IDENT &#125;
end</code></pre>
        <div class="sample-result">
          <small>tokens</small>
          <code>IF</code><code>EQ</code><code>IDENT</code>
          <p><code>/==/</code> wins over <code>/=/</code>: longest match wins.</p>
        </div>
      </figure>
    </section>

    <section class="landing-section" aria-labelledby="why-title">
      <header class="section-intro">
        <h2 id="why-title">One specification from first test to deployment.</h2>
        <p>No separate lexer language and no hidden matching order.</p>
      </header>
      <div class="point-list">
        <article>
          <h3>Ruby-native</h3>
          <p>Use familiar classes, constants, and actions in the language already surrounding your parser.</p>
        </article>
        <article>
          <h3>Explainable</h3>
          <p>Longest match wins. Source order resolves ties. Diagnostics surface unsupported patterns early.</p>
        </article>
        <article>
          <h3>Same rules, two modes</h3>
          <p><a href={`${base}learn/runtime-mode/`}>Runtime mode</a> keeps iteration fast; <a href={`${base}learn/generation/`}>Generated mode</a> makes deployment reproducible.</p>
        </article>
      </div>
    </section>

    <section class="start" aria-labelledby="start-title">
      <div>
        <h2 id="start-title">Start with one Ruby file.</h2>
        <p>Install flexr and follow the short guide.</p>
      </div>
      <code>gem install flexr</code>
      <a class="landing-button primary" href={`${base}learn/getting-started/`}>Open the quick start</a>
    </section>

    <footer class="landing-footer">
      <a class="footer-brand" href={base}>flexr/</a>
      <nav aria-label="Footer navigation">
        <a href={`${base}reference/dsl/`}>Reference</a>
        <a href={`${base}examples/`}>Examples</a>
        <a href={repo}>GitHub</a>
      </nav>
      <p>MIT licensed.</p>
    </footer>
  </main>
</SiteLayout>
