module Flexr
  VERSION: String

  type pattern = String | ::Regexp | Pattern
  type pattern_operand = pattern | Array[pattern_operand]
  type token = [untyped, untyped] | Runtime::Token
  type rule_identity = Symbol | Integer
  type source_location = [Integer, Integer]
  type cancellation = (^() -> untyped) | (^(Lexer) -> untyped) | _Cancellation | _ContextCancellation
  type recovery_action = :skip | :raise | :token | :halt
  type error_handler = (^(LexError) -> recovery_action) | _ErrorHandler

  interface _Cancellation
    def call: () -> untyped
  end

  interface _ContextCancellation
    def call: (Lexer) -> untyped
  end

  interface _ErrorHandler
    def call: (LexError) -> recovery_action
  end

  interface _Input
    def read: (Integer) -> String?
  end

  interface _CompiledPattern
    def accept?: (String) -> bool
  end

  def self.compile_pattern: (pattern, ?options: Hash[Symbol, untyped], ?encoding: Encoding?) -> _CompiledPattern
  def self.parse_pattern: ((String | ::Regexp), ?options: Hash[Symbol, untyped]) -> untyped

  class Pattern
    def |: (pattern_operand) -> Pattern
    def +: (pattern_operand) -> Pattern
    def &: (pattern_operand) -> Pattern
    def -: (pattern_operand) -> Pattern
    def !: () -> Pattern
  end

  class Recognizer
    def match: (String, Integer) -> [rule_identity, Integer]?
             | [Result] (String, Integer) { (rule_identity, Integer) -> Result } -> Result?
  end

  module DSL
    def rule: (pattern | Array[pattern], ?skip: bool, ?emit: untyped, ?followed_by: pattern?) ?{ () [self: Lexer] -> untyped } -> nil
    def pattern: (*pattern_operand) -> Pattern
    def upto: (pattern_operand) -> Pattern
    def state: (*(Symbol | String), ?inclusive: bool) { () [self: singleton(Lexer)] -> untyped } -> void
    def all_states: () { () [self: singleton(Lexer)] -> untyped } -> void
    def on_eof: () { () [self: Lexer] -> untyped } -> void
    def emits: (*untyped) -> void
    def keywords: (Array[String] | Hash[String, Symbol], among: Symbol) -> nil
    def indentation: (newline: Symbol, indent: Symbol, dedent: Symbol, ?brackets: Array[String], ?tab_width: Integer) -> nil
    def backend: (:table | :direct | :auto | :firstmatch | String) -> void
    def token_kind: (:array | :struct | :yield | String) -> void
    def encoding: (Encoding | String) -> void
    def option: (*(Symbol | String)) -> void
    def accel: (:auto | :strscan | :regexp | :none | String) -> void
    def recognizer: (?state: Symbol) -> Recognizer
  end

  class Lexer
    extend DSL

    def initialize: (String | _Input, ?filename: String?, ?error_mode: Symbol, ?max_token_size: Integer, ?max_lookahead_size: Integer?, ?max_buffer_size: Integer, ?max_state_stack: Integer, ?max_steps: Integer?, ?cancellation: cancellation?, ?retain_input: bool, ?chunk_size: Integer) -> void
    def next_token: () -> token?
    def tokens: () -> Array[token]
    def each_token: () -> Enumerator[token, self]
                  | () { (untyped, ?untyped) -> untyped } -> self
    def racc_next_token: () -> [untyped, untyped]
    def checkpoint: () -> Runtime::Checkpoint
    def restore: (Runtime::Checkpoint) -> self
    def seek: (Integer) -> self

    attr_reader filename: String?
    attr_reader error_mode: Symbol
    attr_reader max_token_size: Integer
    attr_reader max_lookahead_size: Integer
    attr_reader steps: Integer
    attr_writer on_error: error_handler?
    def input: () -> String
    def text: () -> String
    def text_bytesize: () -> Integer
    def last_location: () -> Runtime::Location
    def byte_pos: () -> Integer
    def lineno: () -> Integer
    alias line lineno
    def beginning_of_line?: () -> bool
    def state: () -> Symbol
    def binary_input: () -> String
    def emit: (untyped, ?untyped) -> token
    def skip: () -> nil
    def echo: () -> token
    def error!: (String) -> token?
    def push: (Symbol | String) -> Symbol
    alias push_state push
    def pop: () -> Symbol
    alias pop_state pop
    def begin_state: (Symbol | String) -> Symbol
    alias state= begin_state
    def less: (Integer) -> nil
    def more: () -> true
  end

  module Runtime
    class Checkpoint
    end

    class Token < ::Data
      def self.new: (?type: untyped, ?value: untyped, ?location: Location?) -> instance
      attr_reader type: untyped
      attr_reader value: untyped
      attr_reader location: Location?
      def []: (:location | "location") -> Location?
            | (Integer | Symbol | String) -> untyped
      def with: (?type: untyped, ?value: untyped, ?location: Location?) -> self
    end

    class Location < ::Data
      def self.new: (?filename: String?, ?byte_begin: Integer?, ?byte_end: Integer?, ?line_begin: Integer?, ?column_begin: Integer?, ?line_end: Integer?, ?column_end: Integer?) -> instance
      attr_reader filename: String?
      attr_reader byte_begin: Integer?
      attr_reader byte_end: Integer?
      attr_reader line_begin: Integer?
      attr_reader line_end: Integer?
      attr_reader column_begin: Integer?
      attr_reader column_end: Integer?
      def []: (:filename | "filename") -> String?
            | (Integer | Symbol | String) -> (Integer | String)?
      def with: (?filename: String?, ?byte_begin: Integer?, ?byte_end: Integer?, ?line_begin: Integer?, ?column_begin: Integer?, ?line_end: Integer?, ?column_end: Integer?) -> self
    end

    class TokenTooLargeError < LexError
      def initialize: (?String, ?filename: String?, ?byte_pos: Integer?, ?line: Integer?, ?text: String?, ?rule: Integer?) -> void
      attr_reader code: String
      attr_reader rule: Integer?
    end
  end

  class Error < StandardError
    def initialize: (?String?, ?diagnostic: Diagnostic?, ?filename: String?, ?byte_pos: Integer?) -> void
    attr_reader diagnostic: Diagnostic?
    attr_reader filename: String?
    attr_reader byte_pos: Integer?
  end

  class LexError < Error
    def initialize: (String, ?filename: String?, ?byte_pos: Integer?, ?line: Integer?, ?text: String?, ?diagnostic: Diagnostic?) -> void
    attr_reader line: Integer?
    attr_reader text: String?
  end

  class CompileError < Error
  end

  class UnsupportedRegexpError < CompileError
  end

  class Diagnostic < ::Struct[untyped]
    def self.new: (?code: String?, ?severity: Symbol?, ?message: String?, ?location: source_location?, ?help: String?, ?note: String?) -> instance
    attr_accessor code: String?
    attr_accessor severity: Symbol?
    attr_accessor message: String?
    attr_accessor location: source_location?
    attr_accessor help: String?
    attr_accessor note: String?
    def error?: () -> bool
    def warning?: () -> bool
    def to_h: () -> Hash[Symbol, untyped]
  end

  class DiagnosticSet
    include Enumerable[Diagnostic]
    def initialize: () -> void
    def each: () -> Enumerator[Diagnostic, Array[Diagnostic]]
            | () { (Diagnostic) -> untyped } -> Array[Diagnostic]
    def <<: (Diagnostic) -> self
    def any_error?: () -> bool
    def empty?: () -> bool
    def to_a: () -> Array[Diagnostic]
    def render: (?format: Symbol, ?color: Symbol | bool, ?source: String?, ?path: String?) -> String
  end

  module Diagnostics
    def self.error: (String, String, ?location: source_location?, ?help: String?, ?note: String?) -> Diagnostic
    def self.warning: (String, String, ?location: source_location?, ?help: String?, ?note: String?) -> Diagnostic
    def self.info: (String, String, ?location: source_location?, ?help: String?, ?note: String?) -> Diagnostic
    def self.raise!: (Diagnostic) -> bot
  end

  class Generator
    def initialize: (String, ?output: String?, ?eval_mode: bool, ?options: Hash[Symbol, untyped]) -> void
    def generate: () -> String
    attr_reader diagnostics: Array[Diagnostic]
  end

  class RakeTask
    def initialize: (?Symbol | String) ?{ (RakeTask) -> untyped } -> void
    attr_accessor spec: String?
    attr_accessor output: String?
    attr_accessor warn_as_error: bool
  end

  module CLI
    def self.run: (Array[String], ?out: IO | _Output, ?err: IO | _Output) -> Integer
  end

  interface _Output
    def puts: (*untyped) -> nil
    def write: (String) -> Integer
  end
end
